pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building..'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing the build..'
                bat "mvn -f TestNGExperiment/pom.xml clean install"
            }
        }
        stage('Compile') {
            steps {
                echo 'Compiling the build'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the build....'
            }
        }
    }
    
    post {
        always {
            script {
                def buildStatus = currentBuild.currentResult
                emailext(
                    subject: "Jenkins: Build #${env.BUILD_NUMBER} - ${buildStatus}",
                    body: """
                        <p>Build status: ${buildStatus}</p>
                        <p>Job: ${env.JOB_NAME}</p>
                        <p>Build number: ${env.BUILD_NUMBER}</p>
                        <p>Build URL: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                        <p>Check console output at <a href="${env.BUILD_URL}console">${env.BUILD_URL}console</a> to view the results.</p>
                    """,
                    recipientProviders: [[$class: 'DevelopersRecipientProvider']],
                    to: 'mailtomeorkiran@gmail.com'
                )
            }
        }
        success {
            echo 'Build succeeded!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
